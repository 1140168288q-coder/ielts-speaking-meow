# Copy to .env.deploy, replace every placeholder, and keep that file private.
# Always invoke Compose with: docker compose --env-file .env.deploy ...

# Use URL-safe characters. A strong value can be generated with: openssl rand -hex 32
POSTGRES_DB=ielts_meow
POSTGRES_USER=ielts_meow
POSTGRES_PASSWORD=replace_with_a_long_hex_password

AUTH_SESSION_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

FREE_FEEDBACK_MONTHLY_QUOTA=60
FREE_ORGANIZE_MONTHLY_QUOTA=10
FREE_TTS_CHARACTERS_MONTHLY_QUOTA=100000
FREE_PROVIDER_VERIFY_DAILY_QUOTA=10

SYNC_MAX_ITEM_BYTES=65536
SYNC_MAX_BATCH_BYTES=524288
SYNC_MAX_REQUEST_BYTES=655360

# Required only when SMTP account email is enabled.
# Use a fixed public HTTPS entry; account emails also include a copyable one-time token.
APP_ACCOUNT_URL=https://api.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=15

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

VOLC_API_KEY=
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_ENDPOINT=https://openspeech.bytedance.com
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=en_female_anna_mars_bigtts
VOLC_TTS_SPEAKER_NAME=Anna

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
