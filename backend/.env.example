# ============ 雅思口语喵 Backend 环境变量示例 ============
# 复制为 .env 并填入真实值;.env 已被 .gitignore 排除,严禁提交到仓库。

# ---- DeepSeek(Text AI)----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 火山引擎:任选一种鉴权方式 ----
# 方式一(推荐):新版控制台 API Key(控制台 > API Key 管理)
VOLC_API_KEY=
# 方式二:旧版控制台 APP ID + Access Token(官方提示旧版后续下线)
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=

# ---- 火山引擎:接口与资源 ID(默认值即官方文档当前值)----
VOLC_ENDPOINT=https://openspeech.bytedance.com
# 流式语音识别(豆包大模型,时长计费)。两者按账号开通情况二选一:
#   2.0(默认):volc.seedasr.sauc.duration
#   1.0(账号未开通 2.0 时报 403 "resource not granted",此时用 1.0):
#     volc.bigasr.sauc.duration
VOLC_STT_STREAM_RESOURCE_ID=volc.seedasr.sauc.duration
# 语音合成大模型 2.0
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 语音合成 2.0 音色(音色需在控制台确认已开通,否则返回 55000000)。
# 默认 zh_female_vv_uranus_bigtts(中文女声,uranus 系列基础音色);
# 若在控制台开通了英语音色,IELTS 英文播报推荐:
#   en_female_anna_mars_bigtts(英语女声 Anna,考官式播报)
#   或 en_male_jason_conversation_wvae_bigtts(英语男声)
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
# 音色展示名(可选):显示在 /health 与 App 设置页,便于确认当前音色。
VOLC_TTS_SPEAKER_NAME=

# ---- 上传限制 ----
MAX_UPLOAD_MB=25
MAX_STT_DURATION_SECONDS=300

# ---- 流式 STT 会话超时(需小于客户端 180 秒超时)----
STT_STREAM_TIMEOUT_SECONDS=150

# ---- 基础限流(默认关闭,预留)----
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=30
