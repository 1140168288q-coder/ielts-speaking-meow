# ============ 雅思口语喵 Backend 环境变量示例 ============
# 复制为 .env 并填入真实值;.env 已被 .gitignore 排除,严禁提交到仓库。

# ---- 账号与数据库 ----
# 开发默认使用 SQLite；生产可切换为 postgresql+asyncpg://user:pass@host/dbname。
# postgresql:// 与 postgres:// 也会自动转换为 asyncpg 驱动。
DATABASE_URL=sqlite+aiosqlite:///./data/ielts_cat.db
# 服务端会话绝对有效期（秒），默认 30 天；当前版本不提供滑动续期。
AUTH_SESSION_TTL_SECONDS=2592000
# 邮箱验证 token 有效期（秒），默认 24 小时；密码重置默认 1 小时。
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# ---- free plan 默认周期额度 ----
FREE_FEEDBACK_MONTHLY_QUOTA=60
FREE_ORGANIZE_MONTHLY_QUOTA=10
FREE_TTS_CHARACTERS_MONTHLY_QUOTA=100000
FREE_PROVIDER_VERIFY_DAILY_QUOTA=10

# ---- 同步协议 JSON 字节边界 ----
# 单项 64 KiB、业务批次 512 KiB、HTTP 请求 640 KiB。
SYNC_MAX_ITEM_BYTES=65536
SYNC_MAX_BATCH_BYTES=524288
SYNC_MAX_REQUEST_BYTES=655360

# ---- 账号邮件 ----
# 邮件内账号链接的固定公开入口，例如 https://app.example.com/account。
# 生产必须是 HTTPS；绝不从请求 Host 推导。
# 前端页面从 action=verify-email/reset-password 与 token 参数读取操作。
APP_ACCOUNT_URL=
# 未同时配置 SMTP_HOST、SMTP_FROM、APP_ACCOUNT_URL 时，账号邮件保持 disabled。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 例如 no-reply@example.com。
SMTP_FROM=
# 仅支持 starttls（通常 587）或 ssl（通常 465），不提供明文 SMTP 模式。
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=15

# ---- DeepSeek(Text AI)----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 火山引擎:任选一种鉴权方式 ----
# 方式一(推荐):新版控制台 API Key(控制台 > API Key 管理)
VOLC_API_KEY=
# 方式二:旧版控制台 APP ID + Access Token(官方提示旧版后续下线)
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=

# ---- 火山引擎:语音合成(默认值即官方文档当前值)----
VOLC_ENDPOINT=https://openspeech.bytedance.com
# 语音合成大模型 2.0
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 语音合成 2.0 音色(音色需在控制台确认已开通,否则返回 55000000)。
# 默认 zh_female_vv_uranus_bigtts(中文女声,uranus 系列基础音色);
# 若在控制台开通了英语音色,IELTS 英文播报推荐:
#   en_female_anna_mars_bigtts(英语女声 Anna,考官式播报)
#   或 en_male_jason_conversation_wvae_bigtts(英语男声)
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
# 音色展示名(可选):显示在 /health 与 App 设置页,便于确认当前音色。
VOLC_TTS_SPEAKER_NAME=

# ---- 基础限流(默认关闭,预留)----
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=30
