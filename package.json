{
  "name": "ielts-speaking-meow",
  "private": true,
  "version": "2.1.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:backend": "backend\\.venv\\Scripts\\python.exe -m pytest -q -p no:cacheprovider --basetemp=backend/.pytest_tmp -c backend/pytest.ini backend/tests",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "question-bank:update": "node scripts/import-question-bank.mjs",
    "tutor-knowledge:update": "node scripts/import-tutor-knowledge.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:backend && npm run build",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1",
    "android:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 -Release",
    "android:test:device": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 -RunDeviceTests"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "^8.0.0",
    "lucide-react": "^1.33.0",
    "mammoth": "1.12.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
